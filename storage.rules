rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Gallery images: Public viewable, image upload with size & MIME validation
    match /gallery/{allPaths=**} {
      // Anyone can read/view gallery photos
      allow read: if true;

      // Allow upload if it's a valid image under 10MB, or allow delete
      allow write: if request.resource == null 
        || (request.resource.size < 10 * 1024 * 1024 
            && request.resource.contentType.matches('image/.*'));
    }

    // Fallback for all other storage paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
