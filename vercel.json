{
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "server.js": {
      "includeFiles": "{*.html,*.js,*.txt,*.xml,*.png,*.ico,*.webmanifest,admin/**,data/gallery.json}"
    }
  },
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400",
        "X-Content-Type-Options": "nosniff"
      },
      "dest": "/server.js"
    },
    {
      "src": "^/robots\\.txt$",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400",
        "X-Content-Type-Options": "nosniff"
      },
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
